# Application Settings
APP_NAME="Multilingual Course Feedback Intelligence"
APP_ENV="development"
DEBUG=true
API_PORT=8000
DASHBOARD_PORT=8501

# Storage
DATABASE_URL="sqlite:///./course_feedback.db"
MLFLOW_TRACKING_URI="sqlite:///./mlflow.db"

# NLP & Model Hyperparameters
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
MIN_TOPIC_SIZE=10
OUTLIER_THRESHOLD=0.65
CENTROID_COSINE_SIM_THRESHOLD=0.55
POPULATION_STABILITY_INDEX_THRESHOLD=0.25

# Governance & Safety
AUTO_APPROVAL_ENABLED=false
MAX_CANDIDATE_TOPICS_PER_BATCH=5
PII_ANONYMIZATION_ENABLED=true
